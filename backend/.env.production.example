# =====================================================================
# ZION Herbs API -- production
#
# Copy to /var/www/zion/backend/.env and chmod 600. Never commit it.
# Then: python setup_check.py
# =====================================================================

FLASK_ENV=production
PORT=5000

# nginx serves the site and the API from one origin, so the browser makes
# no cross-origin requests at all. This stays set only for the rare case
# of a second front end on another domain; leave it as the live site.
CORS_ORIGINS=https://zionherbs.com

# --- Supabase --------------------------------------------------------
# Session pooler URI, port 5432. Not the direct connection: that host has
# no IPv4 record on most projects and will not resolve from a server.
DATABASE_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=zion-media

# --- Auth ------------------------------------------------------------
# Reuse the values already in use. A new JWT_SECRET signs everyone out;
# a new PRIVACY_PEPPER silently breaks the shared-IP fraud check, because
# hashes written before the change stop matching ones written after.
JWT_SECRET=
JWT_ACCESS_TTL_MIN=45
JWT_REFRESH_TTL_DAYS=30
PRIVACY_PEPPER=

# --- First admin -----------------------------------------------------
# Read once by `seed.py --admin`. Blank these afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=ZION Admin

# --- Payments --------------------------------------------------------
# Webhook: https://zionherbs.com/api/payments/razorpay/webhook
# Events:  payment.captured, payment.failed, refund.processed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PUBLIC_SITE_URL=https://zionherbs.com
