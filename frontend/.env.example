# Local development needs nothing here -- Vite proxies /api to port 5000.
#
# For a deployed build, point this at the API's public URL. Without it the
# frontend calls /api on its own domain, finds nothing, and quietly falls
# back to the offline catalogue: the shop looks fine but no one can sign
# in or order.
#
# No trailing slash, and it must end in /api.
VITE_API_URL=https://zion-api.onrender.com/api
